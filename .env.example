# ---------------------------------------------------------------------------
# Base de données PostgreSQL (Neon en production)
# Neon : https://console.neon.tech  → "Connection string" (pooled, sslmode=require)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/monloyer?sslmode=require"

# URL publique de l'application (liens d'invitation, QR codes, PDF)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret partagé pour l'appel planifié des relances (/api/cron/relances)
CRON_SECRET="changez-moi"

# Mode démonstration de l'OTP : le code est renvoyé dans la réponse API
# (à mettre à true uniquement en local)
OTP_DEBUG_CODE="false"

# Fournisseur SMS/WhatsApp optionnel (non requis pour le MVP)
SMS_PROVIDER_API_KEY=""
