{
  "name": "monloyer.online",
  "version": "1.0.0",
  "private": true,
  "description": "SaaS de gestion locative pour propriétaires, agences immobilières et résidences (Côte d'Ivoire / Afrique de l'Ouest)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
